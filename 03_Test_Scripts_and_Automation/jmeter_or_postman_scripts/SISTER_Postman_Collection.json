{
  "info": {
    "name": "SISTER - API Collection (ASTQA Final Project)",
    "description": "Koleksi Postman untuk uji fungsional & dasar load testing (via Newman Runner) endpoint utama SISTER. Jalankan folder 'Auth' terlebih dahulu agar cookie session (sid) tersimpan otomatis di Postman cookie jar, lalu jalankan folder lain.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "sid",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /login - valid credentials (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 302 redirect to /dashboard', function () {",
                  "  pm.expect(pm.response.code).to.equal(302);",
                  "  pm.expect(pm.response.headers.get('Location')).to.equal('/dashboard');",
                  "});",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const m = setCookie.match(/sid=([^;]+)/);",
                  "if (m) { pm.collectionVariables.set('sid', m[1]); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "admin@sekolah.test"
                },
                {
                  "key": "password",
                  "value": "password123"
                }
              ]
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "POST /login - invalid password (EP: invalid class)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 302 redirect back to /login', function () {",
                  "  pm.expect(pm.response.code).to.equal(302);",
                  "  pm.expect(pm.response.headers.get('Location')).to.equal('/login');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Cookie",
                "value": "sid={{sid}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "admin@sekolah.test"
                },
                {
                  "key": "password",
                  "value": "wrong-password"
                }
              ]
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "POST /login - empty password (BVA: boundary min)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Cookie",
                "value": "sid={{sid}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "admin@sekolah.test"
                },
                {
                  "key": "password",
                  "value": ""
                }
              ]
            },
            "url": "{{base_url}}/login"
          }
        }
      ]
    },
    {
      "name": "Dashboard & RBAC",
      "item": [
        {
          "name": "GET /dashboard - authenticated",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/dashboard",
            "header": [
              {
                "key": "Cookie",
                "value": "sid={{sid}}"
              }
            ]
          }
        },
        {
          "name": "GET /users - as admin (should be 200)",
